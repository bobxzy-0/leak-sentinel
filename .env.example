DATABASE_URL=sqlite:///./leak_sentinel.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=replace-with-a-fernet-key
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional paid HIBP API. Hudson Rock community OSINT is enabled by default.
HIBP_API_KEY=
HUDSON_ROCK_ENABLED=true
# Optional Mozilla Monitor integration. Token must be an FxA bearer JWT and
# only exposes email addresses already monitored by that Firefox Account.
MOZILLA_MONITOR_ENABLED=false
MOZILLA_MONITOR_TOKEN=
SCAN_INTERVAL_MINUTES=60

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
